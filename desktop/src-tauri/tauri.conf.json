{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DriverRadar",
  "version": "1.5.0",
  "identifier": "com.driverradar.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DriverRadar",
        "width": 1240,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#05090e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/app",
      "resources/node"
    ],
    "publisher": "yourbossdonpely",
    "copyright": "MIT licensed",
    "category": "Utility",
    "shortDescription": "Scan and update Windows drivers",
    "longDescription": "DriverRadar inventories every device on a Windows PC, verifies the newest WHQL driver package against the Microsoft Update Catalog and downloads it over parallel connections. Scanning is read-only, installs are explicit, and nothing leaves the machine.",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
