{
  "name": "driver-radar",
  "version": "1.0.0",
  "private": false,
  "description": "Open-source Windows driver scanner and updater: verifies packages against the Microsoft Update Catalog and downloads them over parallel connections.",
  "main": "server.js",
  "scripts": {
    "start": "node supervisor.js --open",
