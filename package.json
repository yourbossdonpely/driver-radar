{
  "name": "driver-radar",
  "version": "1.4.1",
  "private": false,
  "description": "Open-source Windows driver scanner and updater: verifies packages against the Microsoft Update Catalog and downloads them over parallel connections.",
  "author": "yourbossdonpely <yourbossdonpely@users.noreply.github.com> (https://github.com/yourbossdonpely)",
  "main": "server.js",
  "bin": {
    "driver-radar": "cli.js"
  },
  "files": [
    "cli.js",
    "server.js",
    "supervisor.js",
    "check-nvidia.js",
    "start.cmd",
    "appicon.png",
    "requirements.txt",
    "lib/",
    "public/",
    "scripts/",
    "installer/"
  ],
  "scripts": {
    "start": "node supervisor.js --open",
    "serve": "node server.js",
    "supervise": "node supervisor.js",
    "scan": "node cli.js scan",
    "list": "node cli.js list",
    "test": "node test/run.js"
  },
  "keywords": [
    "windows",
    "drivers",
    "driver-updater",
    "microsoft-update-catalog",
    "windows-update",
    "pnputil",
    "powershell"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
